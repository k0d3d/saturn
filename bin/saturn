#!/usr/bin/env bash
set -euo pipefail
action="${1:-open}"
case "$action" in
  tasks)
    shift
    sub="${1:-list}"; a="${2:-}"; b="${3:-}"
    exec_shell_command=(omarchy-shell saturn tasks "$sub" "$a" "$b")
    ;;
  notes)
    shift
    sub="${1:-list}"; a="${2:-}"; b="${3:-}"; c="${4:-}"; d="${5:-}"
    exec_shell_command=(omarchy-shell saturn notes "$sub" "$a" "$b" "$c" "$d")
    ;;
  data)
    shift
    sub="${1:-get}"; a="${2:-}"; b="${3:-}"; c="${4:-}"; d="${5:-}"
    exec_shell_command=(omarchy-shell saturn data "$sub" "$a" "$b" "$c" "$d")
    ;;
  vault)
    shift
    sub="${1:-status}"
    if [[ "$sub" == "status" ]]; then
      exec python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../scripts/vault_sync.py" status
    fi
    exec omarchy-shell saturn vaultSync "$sub"
    ;;
  calendar)
    shift
    sub="${1:-list}"; a="${2:-}"; b="${3:-}"
    if [[ "$sub" == "status" ]]; then
      exec python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../scripts/calendar_sync.py" status
    fi
    if [[ "$sub" == "sync" ]]; then
      exec omarchy-shell saturn calendarSync sync
    fi
    exec omarchy-shell saturn calendar "$sub" "$a" "$b"
    ;;
  graph)
    shift
    exec python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../scripts/saturn_graph.py" "$@"
    ;;
  open|notesOpen|command|connections|dashboard|close|status|toggle) exec_shell_command=(omarchy-shell saturn "$action") ;;
  --version) echo 'Saturn 0.8.0'; exit 0 ;;
  --help|-h)
    echo 'Usage: saturn [open|notesOpen|command|connections|dashboard|close|status|toggle'
    echo '       tasks [list|add|complete|archive|restore|due] ...'
    echo '       notes [list|search|add|update|pin|archive|restore] ...'
    echo '       data [get|sync-status|tasks ...|notes ...|add-task ...|add-note ...]'
    echo '       vault [push|pull|sync|status]'
    echo '       calendar [list|add|archive|sync|status]'
    echo '       graph [status|reindex|link|unlink|neighbors|path|list|resolve|forget|backup]'
    exit 0 ;;
  *)
    if [[ "$action" == assistant || "$action" == messages || "$action" == voice* || "$action" == grok* ]]; then
      echo "$action is no longer available in Saturn. Use OpenCode for assistant work." >&2
      exit 3
    fi
    echo 'Unknown command. Run saturn --help.' >&2; exit 2 ;;
esac
if ! command -v omarchy-shell >/dev/null; then
  echo 'Saturn requires the Omarchy desktop shell.' >&2; exit 1
fi
exec "${exec_shell_command[@]}"
