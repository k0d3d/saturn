#!/usr/bin/env bash
set -euo pipefail
action="${1:-open}"
case "$action" in
  tasks)
    shift
    command="${1:-list}"
    first="${2:-}"
    second="${3:-}"
    if ! command -v omarchy-shell >/dev/null; then
      echo 'Saturn requires the Omarchy desktop shell.' >&2; exit 1
    fi
    exec omarchy-shell saturn tasks "$command" "$first" "$second"
    ;;
  open|command|assistant|connections|messages|dashboard|close|status|toggle|voiceEnable|voiceWakeEnable|voiceDisable|voiceToggle|voiceStop|voiceStatus|grokStart|grokStop|grokStatus) ;;
  --version) echo 'Saturn 0.8.0'; exit 0 ;;
  --help|-h)
    echo 'Usage: saturn [open|command|assistant|connections|messages|dashboard|close|status|toggle|tasks [list|add|complete|archive|restore|due] ...]'
    exit 0 ;;
  *) echo 'Unknown command. Run saturn --help.' >&2; exit 2 ;;
esac
if ! command -v omarchy-shell >/dev/null; then
  echo 'Saturn requires the Omarchy desktop shell.' >&2; exit 1
fi
exec omarchy-shell saturn "$action"
